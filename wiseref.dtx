% \subsection{Label metadata and environment adapters}
% LaTeX writes standard labels; this package records their types and tag modes.
% Rerun detection compares serialized text so that catcode differences are not
% mistaken for changes to reference types.
%    \begin{macrocode}
\NewDocumentCommand \wiserefRecord { m m m }
  { \prop_gput:Nnn \g__wise_labels_prop {#1} { {#2}{#3} } }
% A distinct suffix namespace avoids collisions with ordinary label records.
% xr/xr-hyper preserve that suffix when adding an external document prefix.
\cs_new_protected:Npn\__wise_record_properties: { }
\cs_new_protected:Npn\__wise_external_type:n #1 { }
\cs_if_exist:NT\RecordProperties
  {\cs_if_exist:NT\IfPropertyRecordedTF
    {\NewProperty{wiseref-type}{now}{}{\l__wise_current_type_tl}
     \NewProperty{wiseref-format}{now}{normal}{\l__wise_format_mode_tl}
     \cs_set_protected:Npn\__wise_record_properties:
       {\RecordProperties{\l__wise_label_key_tl @wiseref}{wiseref-type,wiseref-format}}
     \cs_set_protected:Npn\__wise_external_type:n #1
       {\IfPropertyRecordedT{#1@wiseref}{wiseref-type}
         {\tl_set:Ne\l__wise_current_type_tl{\RefProperty{#1@wiseref}{wiseref-type}}
          \IfPropertyRecordedT{#1@wiseref}{wiseref-format}
            {\tl_set:Ne\l__wise_format_mode_tl{\RefProperty{#1@wiseref}{wiseref-format}}}}}}}
% Old auxiliary files remain readable if the user later removes the package.
\AddToHook{begindocument}[wiseref]
  {\iow_now:Nn\@auxout{\providecommand\wiserefRecord[3]{}}}
\cs_new_protected:Npn \__wise_capture:n #1
  {
    \tl_set:Ne\l__wise_label_key_tl{#1}
    \tl_set:Ne \l__wise_current_type_tl {\@currentcounter}
    \tl_if_empty:NF\l__wise_ntheorem_counter_tl
      {\str_if_eq:eeT{\@currentcounter}{\l__wise_ntheorem_counter_tl}
        {\tl_set_eq:NN\l__wise_current_type_tl\l__wise_ntheorem_type_tl}}
    \tl_if_empty:NF \l__wise_override_type_tl
      {\tl_set_eq:NN \l__wise_current_type_tl \l__wise_override_type_tl}
    \bool_if:NT \l__wise_appendix_bool
      {
        \cs_if_exist:NTF \chapter
          {\str_if_eq:VnT \l__wise_current_type_tl {chapter}{\tl_set:Nn \l__wise_current_type_tl {appendix}}}
          {\str_if_eq:VnT \l__wise_current_type_tl {section}{\tl_set:Nn \l__wise_current_type_tl {appendix}}}
      }
    \bool_if:NT \l__wise_unnumbered_bool {\tl_clear:N \l__wise_current_type_tl}
    \tl_if_empty:NF\l__wise_ntheorem_counter_tl
      {\str_if_eq:eeT{\@currentcounter}{\l__wise_ntheorem_counter_tl}
        {\bool_if:NF\l__wise_ntheorem_numbered_bool{\tl_clear:N\l__wise_current_type_tl}}}
    \tl_set:Nn \l__wise_format_mode_tl {normal}
    \str_if_eq:VnT \l__wise_current_type_tl {equation}
      {
        \bool_if:NT \g__wise_custom_tag_bool {\tl_set:Nn \l__wise_format_mode_tl {tag}}
        \bool_if:NT \g__wise_bare_tag_bool {\tl_set:Nn \l__wise_format_mode_tl {bare}}
      }
    \tl_set:Ne\l_tmpa_tl{{\l__wise_current_type_tl}{\l__wise_format_mode_tl}}
    \prop_get:NVNTF\g__wise_labels_prop\l__wise_label_key_tl\l_tmpb_tl
      {\str_if_eq:eeF{\tl_to_str:V\l_tmpa_tl}{\tl_to_str:V\l_tmpb_tl}
        {\bool_gset_true:N\g__wise_rerun_bool}}
      {\bool_gset_true:N\g__wise_rerun_bool}
    \protected@write\@auxout{}
      {\string\wiserefRecord{\l__wise_label_key_tl}{\l__wise_current_type_tl}{\l__wise_format_mode_tl}}
    \__wise_record_properties:
  }
\AddToHook{enddocument}[wiseref]
  {\bool_if:NT\g__wise_rerun_bool
    {\@latex@warning@no@line{Label(s)~may~have~changed.~Rerun~to~get~wiseref~types~right}}}
\AddToHookWithArguments{label}[wiseref]{\__wise_capture:n{#1}}
% Keep optional-argument refstepcounter dispatchers (e.g. cleveref) intact.
% Page shipping alone does not create a new numbered reference target.
\AddToHookWithArguments{cmd/stepcounter/after}[wiseref]
  {\str_if_eq:nnF{#1}{page}{\bool_set_false:N\l__wise_unnumbered_bool}}
\AddToHook{cmd/appendix/after}[wiseref]{\bool_set_true:N \l__wise_appendix_bool}
\cs_if_exist:NT\appendices
  {\AddToHook{cmd/appendices/after}[wiseref]{\bool_set_true:N\l__wise_appendix_bool}}
% IEEEtran renders numbered appendices through its starred section machinery.
% Preserve the public section command's star distinction in that mode.
\cs_new_protected:Npn\__wise_ieee_appendices:
  {
    \bool_set_true:N\l__wise_appendix_bool
    \cs_set_eq:NN\__wise_ieee_section:\section
    \RenewDocumentCommand\section{s o m}
      {\IfBooleanTF{##1}
        {\IfNoValueTF{##2}{\__wise_ieee_section:*{##3}}{\__wise_ieee_section:*[##2]{##3}}
         \bool_set_true:N\l__wise_unnumbered_bool}
        {\IfNoValueTF{##2}{\__wise_ieee_section:{##3}}{\__wise_ieee_section:[##2]{##3}}
         \bool_set_false:N\l__wise_unnumbered_bool}}
  }
\IfClassLoadedTF{IEEEtran}
  {\AddToHook{cmd/appendices/after}[wiseref/ieee]{\__wise_ieee_appendices:}}
  {\AddToHook{class/IEEEtran/after}[wiseref/ieee]
    {\AddToHook{cmd/appendices/after}[wiseref/ieee]{\__wise_ieee_appendices:}}}
\AddToHook{cmd/@ssect/before}[wiseref]{\bool_set_true:N \l__wise_unnumbered_bool}
\cs_if_exist:NT \@schapter
  {\AddToHook{cmd/@schapter/before}[wiseref]{\bool_set_true:N \l__wise_unnumbered_bool}}
\cs_new_protected:Npn \__wise_amsmath:
  {\bool_if:NF \g__wise_amsmath_ready_bool
    {\bool_gset_true:N \g__wise_amsmath_ready_bool \__wise_amsmath_install:}}
\cs_new_protected:Npn \__wise_amsmath_install:
  {
    \AddToHook{cmd/make@df@tag@@/before}[wiseref]
      {\bool_gset_true:N \g__wise_bare_tag_bool \bool_gset_true:N \g__wise_custom_tag_bool}
    \AddToHook{cmd/make@df@tag@@@/before}[wiseref]
      {\bool_gset_false:N \g__wise_bare_tag_bool \bool_gset_true:N \g__wise_custom_tag_bool}
    \AddToHook{cmd/make@display@tag/after}[wiseref]
      {\bool_gset_false:N \g__wise_bare_tag_bool \bool_gset_false:N \g__wise_custom_tag_bool}
    \clist_map_inline:nn {equation,align,gather,multline,flalign,alignat,equation*,align*,gather*,multline*}
      {\AddToHook{env/##1/before}[wiseref]
        {\bool_gset_false:N \g__wise_bare_tag_bool \bool_gset_false:N \g__wise_custom_tag_bool}}
    \clist_map_inline:nn {equation,align,gather,multline,flalign,alignat,subequations,equation*,align*,gather*,multline*}
      {\AddToHook{env/##1/begin}[wiseref]{\wisereftype{equation}}}
  }
\AddToHook{package/amsmath/after}[wiseref]{\__wise_amsmath:}
\IfPackageLoadedT{amsmath}{\__wise_amsmath:}
% ntheorem 1.33 has a fixed three-argument entry: environment, counter, title.
% A before hook leaves its trailing optional-title dispatcher untouched.
\cs_new_protected:Npn\__wise_ntheorem_begin:nn #1#2
  {\tl_set:Ne\l__wise_ntheorem_type_tl{#1}
   \tl_set:Ne\l__wise_ntheorem_counter_tl{#2}
   \bool_set_true:N\l__wise_ntheorem_numbered_bool
   \cs_if_exist:NT\thm@starredenv{\bool_set_false:N\l__wise_ntheorem_numbered_bool}
   \cs_if_exist:cT{setparms@#1}
     {\tl_set:Ne\l__wise_ntheorem_style_tl{\cs_replacement_spec:c{setparms@#1}}
      \exp_args:NnV\regex_match:nnT{th@(?:nonumber|empty)}\l__wise_ntheorem_style_tl
        {\bool_set_false:N\l__wise_ntheorem_numbered_bool}}}
\cs_new_protected:Npn\__wise_ntheorem:
  {\bool_if:NF\g__wise_ntheorem_ready_bool
    {\bool_gset_true:N\g__wise_ntheorem_ready_bool
     \str_if_eq:eeTF{\cs_parameter_spec:N\@thm}
       {\c_hash_str 1\c_hash_str 2\c_hash_str 3}
       {\AddToHookWithArguments{cmd/@thm/before}[wiseref/ntheorem]
         {\__wise_ntheorem_begin:nn{##1}{##2}}}
       {\msg_warning:nn{wiseref}{ntheorem-signature}}}}
\AddToHook{package/ntheorem/after}[wiseref]{\__wise_ntheorem:}
\IfPackageLoadedT{ntheorem}{\__wise_ntheorem:}
