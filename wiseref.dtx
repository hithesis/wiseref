% \ifWiseDocEnglish
% wiseref adds type names to cross-references and formats lists of labels.
% Instead of writing \texttt{Figure}\verb|~\ref{picture}|, use
% \verb|\wref{picture}| and configure the wording in one place.
% Names may appear before or after numbers; number formats and list separators
% can be set independently.
% \begin{itemize}
% \item Types are read from label records, so label names need no special prefixes.
% \item Omitted prefix/suffix arguments keep the settings; empty arguments clear them.
% \item Number formatting changes the reference text, not the counter's numbering.
% \item Lists support grouping, sorting, ranges, and a choice of linked text.
% \end{itemize}
% Hyperref's \cs{autoref} adds type names, and cleveref and zref-clever also
% format reference lists. Wiseref offers a prefix/suffix interface with separate
% number formats. Special counters may need additional settings or an adapter.
% Language profiles contain singular and plural names; they do not handle
% grammatical inflection. The document supplies fonts and text direction.
% \else
% wiseref 为交叉引用添加类型名称，也可一次引用多个标签。
% 例如，把 \verb|图\ref{picture}| 写成 \verb|\wref{picture}|，
% 再统一设置“图”的名称、编号格式和连接词。名称既可放在编号前，也可放在编号后。
% \begin{itemize}
% \item 从标签记录读取类型，标签名无须约定前缀。
% \item 前后缀参数省略时沿用设置，留空时清除，也可为单次引用另行指定。
% \item 编号格式只改变引用的显示方式，不改变计数器编号。
% \item 多标签可分组、排序或压缩为范围，链接范围也可配置。
% \end{itemize}
% hyperref 的 \cs{autoref} 能添加类型名，cleveref 和 zref-clever 也能处理引用列表。
% wiseref 使用前后缀接口，并将编号格式单独设置。
% 特殊计数器可能需要补充配置或编写适配。
% 语言预设包含单复数名称，不自动处理语法变格；字体和文字方向由文档设置。
% \fi
