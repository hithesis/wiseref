% Manual-only counters and real label targets; no auxiliary records are fabricated.
\newcounter{WiseDocExample}
\newcounter{WiseDocChapter}
\newcounter{experiment}
\newcommand\WiseDocLive[4]{%
  \par\addvspace{7pt}\noindent\begin{minipage}{\linewidth}%
  \refstepcounter{WiseDocExample}%
  \setlength\fboxsep{7pt}\setlength\fboxrule{.3pt}%
  \fcolorbox{WiseBorder}{WiseSoft}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}%
      {\small\sffamily\bfseries\color{WiseAccent}%
        \WiseDocText{Example}{示例} \arabic{WiseDocExample}.\enspace #2}\par\smallskip
      \if\relax\detokenize{#3}\relax\else\WiseDocCode{#3}\fi
      \WiseDocCode{#4}%
      \smallskip{\color{WiseBorder}\hrule}\smallskip
      {\footnotesize\sffamily\color{WiseInk}\WiseDocText{Live result}{实际效果}}\par
      \begingroup #3%
        \noindent\hypertarget{live.#1}{}#4\par
      \endgroup
    \end{minipage}}%
  \end{minipage}\par\addvspace{4pt}}
\newcommand\WiseDocRow[2]{\hypertarget{row.#1}{}#2}
\newcommand\WiseDocLinkRow[2]{%
  \begingroup\wiserefsetup{links=#2}%
    \hypertarget{live.#1}{}\wref[Head~]{picture-a,picture-b}[~Tail]%
  \endgroup}
\newcommand\WiseDocLinkPanel{%
  \par\addvspace{7pt}\noindent\begin{minipage}{\linewidth}%
  \refstepcounter{WiseDocExample}%
  \setlength\fboxsep{7pt}\setlength\fboxrule{.3pt}%
  \fcolorbox{WiseBorder}{WiseSoft}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}%
      {\small\sffamily\bfseries\color{WiseAccent}%
        \WiseDocText{Example}{示例} \arabic{WiseDocExample}.\enspace
        \WiseDocText{Comparing link scopes}{链接范围对照}}\par\smallskip
      \WiseDocCode{\wref[Head~]{picture-a,picture-b}[~Tail]}%
      \smallskip{\color{WiseBorder}\hrule}\smallskip
      \begin{tabular}{@{}ll@{}}
        {\small\sffamily\WiseDocText{Setting}{设置}} &
        {\small\sffamily\WiseDocText{Live result}{实际效果}}\\[2pt]
        \texttt{links=none} & \WiseDocLinkRow{links-none}{none}\\
        \texttt{links=numbers} & \WiseDocLinkRow{links-numbers}{numbers}\\
        \texttt{links=numbers-and-affixes} & \WiseDocLinkRow{links-affixes}{numbers-and-affixes}
      \end{tabular}
    \end{minipage}}%
  \end{minipage}\par\addvspace{4pt}}
\newcommand\WiseDocTargets{%
  \begin{minipage}{\linewidth}
    \begin{minipage}[t]{.30\linewidth}\centering
      \framebox[.9\linewidth]{\rule{0pt}{9mm}\sffamily A}
      \captionof{figure}{\WiseDocText{System structure}{系统结构}}%
      \label{structure}\label{picture}\label{picture-a}
    \end{minipage}\hfill
    \begin{minipage}[t]{.30\linewidth}\centering
      \framebox[.9\linewidth]{\rule{0pt}{9mm}\sffamily B}
      \captionof{figure}{\WiseDocText{Second target}{第二个对象}}\label{picture-b}
    \end{minipage}\hfill
    \begin{minipage}[t]{.30\linewidth}\centering
      \framebox[.9\linewidth]{\rule{0pt}{9mm}\sffamily C}
      \captionof{figure}{\WiseDocText{Third target}{第三个对象}}\label{picture-c}
    \end{minipage}
  \end{minipage}\par\medskip
  \begin{minipage}[t]{.46\linewidth}\centering
    \captionof{table}{\WiseDocText{Sample data}{示例数据}}\label{table-a}
    \begin{tabular}{cc}\toprule A&B\\\midrule 1&2\\\bottomrule\end{tabular}
  \end{minipage}\hfill
  \begin{minipage}[t]{.46\linewidth}\raggedright
    \begingroup\wisereftype{chapter}\setcounter{WiseDocChapter}{1}%
      \refstepcounter{WiseDocChapter}\label{chapter}%
      \textbf{\WiseDocText{Chapter-type target}{章类型目标}}\quad\ref{chapter}\par
    \endgroup
    \WiseDocText{This article-class manual uses a dedicated counter for the chapter example.}{本手册使用独立计数器演示章类型，正文节编号不受影响。}\par\smallskip
    \refstepcounter{experiment}\label{exp:first}%
    \textbf{\WiseDocText{Experiment target}{实验目标}}\quad\ref{exp:first}
  \end{minipage}\par\medskip
  \setcounter{equation}{2}%
  \begin{equation}a=b\label{equation}\end{equation}
  \begin{equation}c=d\tag{S}\label{live-tag}\end{equation}
  % Tagged displays do not advance the counter; keep their automatic anchors unique.
  \setcounter{equation}{4}%
  \begin{equation}e=f\tag*{S}\label{live-bare}\end{equation}}
